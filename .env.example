# Meetly Environment Configuration
# Maintained by Evolix Studio

# Server Port
PORT=3000

# Node Environment: development | production | test
NODE_ENV=production

# Database Configuration (MySQL connection string for safety report persistence)
# Example: mysql://user:password@localhost:3306/meetly
DATABASE_URL=mysql://meetly_user:secure_password@127.0.0.1:3306/meetly

# Secret used to sign temporary anonymous session tokens (HMAC-SHA256)
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
# If left unset, an ephemeral random key is generated at server boot.
SESSION_SECRET=your_secure_random_session_secret_at_least_32_characters

# CORS Allowed Origins
# Use comma-separated URLs or '*' for all origins
# Example: https://meetly.evolix.studio,https://app.meetly.evolix.studio
CORS_ORIGIN=*

# WebRTC STUN Servers (comma-separated list)
# Default: stun:stun.l.google.com:19302
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# WebRTC TURN Relay Servers (Optional, recommended for production NAT traversal)
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349
# TURN_USERNAME=meetly_turn_user
# TURN_CREDENTIAL=meetly_turn_password
