# Meetly Environment Configuration
# Maintained by Evolix Studio

# Server Port
PORT=3000

# Node Environment: development | production | test
NODE_ENV=production

# Database Configuration (MySQL connection string for safety report persistence)
# Replace <DB_USER>, <DB_PASSWORD>, and <DB_HOST> with your production credentials
# Example: mysql://meetly_user:STRONG_UNIQUE_PASSWORD@127.0.0.1:3306/meetly
DATABASE_URL=mysql://meetly_user:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:3306/meetly

# Secret used to sign temporary anonymous session tokens (HMAC-SHA256)
# REQUIRED in production. Must be at least 32 characters (e.g. run `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_AT_LEAST_32_CHARS

# Moderator API Key (used for operator triage of abuse reports via /api/moderation/* and moderation-cli)
# REQUIRED in production. Must be at least 24 characters (e.g. run `openssl rand -hex 24`)
MODERATOR_KEY=REPLACE_WITH_SECURE_OPERATOR_KEY_AT_LEAST_24_CHARS

# CORS Allowed Origins
# Specify your authoritative production domain(s), comma-separated.
# DO NOT use '*' in production.
# Example: https://meetly.evolix.studio,https://app.meetly.evolix.studio
CORS_ORIGIN=https://meet-ly.in

# WebRTC STUN Servers (comma-separated list)
# Default: stun:stun.l.google.com:19302
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# WebRTC TURN Relay Servers (Recommended for production NAT traversal)
# Provide TURN servers over UDP, TCP, and TLS (TURNS)
TURN_SERVERS=turn:turn.meetly.chat:3478?transport=udp,turn:turn.meetly.chat:3478?transport=tcp,turns:turn.meetly.chat:5349?transport=tcp

# Ephemeral Time-Limited TURN Credentials (RFC 5766 / Coturn REST API mechanism)
# When TURN_SHARED_SECRET is set, the server dynamically generates HMAC-SHA1 credentials per session.
# Generate with: `openssl rand -hex 32`
TURN_SHARED_SECRET=REPLACE_WITH_COTURN_SHARED_SECRET
TURN_REALM=meetly.internal
TURN_CREDENTIAL_TTL=86400

# Static TURN credentials fallback (if not using shared secret)
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Docker Compose Database Settings (Required if using docker-compose.yml)
# Generate with: `openssl rand -base64 24`
DB_PASSWORD=REPLACE_WITH_UNIQUE_APP_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_ROOT_DB_PASSWORD

# ==============================================================================
# LEGAL, PRIVACY & REGULATORY COMPLIANCE SETTINGS (INDIA / IT RULES / DPDP / CERT-IN)
# ==============================================================================

# Site Branding & Authoritative Public URL
SITE_NAME=Meetly
PUBLIC_SITE_URL=https://meet-ly.in

# Operator Legal Identification
LEGAL_OPERATOR_NAME=Evolix Studio
# Configure only the operator's verified entity classification; do not assume incorporation.
LEGAL_ENTITY_TYPE=
LEGAL_CONTACT_EMAIL=legal@meetly.evolix.studio
PRIVACY_CONTACT_EMAIL=privacy@meetly.evolix.studio

# Grievance Officer Details (MANDATORY under Rule 3(2) of the IT Rules, 2021)
# Must be formally appointed resident in India before public launch
GRIEVANCE_OFFICER_NAME="[Replace with Formally Appointed Grievance Officer Full Name]"
GRIEVANCE_OFFICER_DESIGNATION="Grievance Officer (under Rule 3(2) IT Rules, 2021)"
GRIEVANCE_OFFICER_EMAIL=grievance@meetly.evolix.studio
GRIEVANCE_POSTAL_ADDRESS="[Replace with Registered Operational Postal Address in India]"

# User Age Limit & Policy Dates
# Under DPDP Act 2023 Section 9, processing minors' data requires verifiable parental consent.
# For anonymous chat, minimum age must remain strictly 18+.
MINIMUM_USER_AGE=18
TERMS_EFFECTIVE_DATE="October 29, 2026"
PRIVACY_POLICY_EFFECTIVE_DATE="October 29, 2026"

# CERT-In Log Retention Mandate (Directions 2022 Paragraph 5(v))
# Intermediaries must retain ICT system & security logs for 180 days rolling within India.
CERT_IN_LOG_RETENTION_DAYS=180

# Advertising & Monetization (Google Publisher & AdSense Compliance)
# Set on the FRONTEND BUILD host (Cloudflare/Netlify/Render), then rebuild.
# Only published /blog/:slug articles are eligible. Home/chat, legal, forms and errors are excluded.
# Publisher IDs are public; no VITE_ duplicate is needed. Never use a made-up ID.
ENABLE_ADS=false
ADSENSE_CLIENT_ID=ca-pub-9094414017454069
# Keep false until Google's certified CMP is published and tested in Privacy & messaging.
# This is a deployment assertion, not the visitor's consent.
ADSENSE_CMP_READY=false
ANALYTICS_PROVIDER="Disabled (Privacy-by-Design)"
HOSTING_PROVIDER="Self-Hosted / Cloud VPS"
